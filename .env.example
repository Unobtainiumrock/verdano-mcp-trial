# Copy this file to `.env` and populate the values below.
# `.env` is gitignored; never commit credentials.

# Trial ERP base URL (per the README brief).
CPG_RECONCILER_ERP_BASE_URL=https://erp.corvera.ai

# Trial API key — copy from the README brief in this repo.
CPG_RECONCILER_ERP_API_KEY=

# Optional. Absolute path to the repo root — set automatically by setup-mcp.sh.
# Needed when the MCP host launches the server from a different working directory.
# CPG_RECONCILER_PROJECT_ROOT=/absolute/path/to/challenge

# --- Storage backend (D-025) ---
# Persistence backend: "memory" (default, process-lifetime) or "duckdb" (file-backed).
# CPG_RECONCILER_STORAGE_BACKEND=memory
# Path to the DuckDB file (only used when storage_backend=duckdb).
# CPG_RECONCILER_DUCKDB_PATH=.local/cpg_reconciler.duckdb

# --- Pipeline thresholds (all have sensible defaults; override to tune) ---
# CPG_RECONCILER_TAU_SAFE=0.90
# CPG_RECONCILER_AUTO_THRESHOLD=0.90
# CPG_RECONCILER_TFIDF_MIN_SCORE=0.5
# CPG_RECONCILER_TFIDF_MIN_MATCHED_TOKENS=2
# CPG_RECONCILER_FUZZY_JW_MIN_SCORE=0.30
# Legacy alias: CPG_RECONCILER_E4_MIN_SCORE also accepted for backward compatibility
# CPG_RECONCILER_FS_EPSILON=0.02
# CPG_RECONCILER_FS_GAMMA=0.10
# CPG_RECONCILER_FS_ALPHA=1.5
# CPG_RECONCILER_DRIFT_THRESHOLD_LOW=0.5
# CPG_RECONCILER_DRIFT_THRESHOLD_HIGH=1.5
# CPG_RECONCILER_DRIFT_RESIDUAL_THRESHOLD=0.10
# CPG_RECONCILER_DEPOT_FUZZY_THRESHOLD=75
# CPG_RECONCILER_DEPOT_LLM_MIN_CONFIDENCE=0.50

# --- LLM integration (optional) ---
# Provider-agnostic via OpenAI-compatible SDK. Set base_url for local models.
# CPG_RECONCILER_LLM_MODEL=gpt-4o
# CPG_RECONCILER_LLM_API_KEY=
# CPG_RECONCILER_LLM_BASE_URL=https://api.openai.com/v1

# --- LLM re-ranker (D-019) ---
# Post-cascade validator for low-confidence or ambiguous mappings.
# CPG_RECONCILER_RERANK_THRESHOLD=0.92
# CPG_RECONCILER_RERANK_STRATA=tfidf_overlap,fuzzy_jw
# CPG_RECONCILER_RERANK_MIN_LLM_CONFIDENCE=0.70

# --- Markov drift (D-024) ---
# Minimum weeks of residual history before Markov analysis runs per SKU.
# CPG_RECONCILER_DRIFT_MARKOV_MIN_WEEKS=4
# Consecutive non-accurate weeks to flag persistence signal.
# CPG_RECONCILER_DRIFT_MARKOV_PERSISTENCE_THRESHOLD=3
# Maximum weeks of history to load per SKU (caps query cost / memory).
# CPG_RECONCILER_DRIFT_MARKOV_MAX_WEEKS=52
# KL divergence threshold for regime-drift flagging.
# CPG_RECONCILER_DRIFT_MARKOV_KL_THRESHOLD=0.5

# --- Normalization (D-023) ---
# Independent toggles for extended normalization steps.
# Brand-prefix stripping removes manufacturer prefixes from product names.
# Stop-word removal removes filler words that add noise to fuzzy matching.
# CPG_RECONCILER_NORMALIZE_BRAND_STRIPPING=false
# CPG_RECONCILER_BRAND_PREFIXES=verdano,verdano foods
# CPG_RECONCILER_NORMALIZE_STOP_WORDS=false
# CPG_RECONCILER_STOP_WORDS=the,and,with,pack,of,for

# --- Confidence hooks (D-022) ---
# Temperature-band keyword mismatch penalty. When enabled, if the matched
# ERP product's name contains keywords suggesting a different temperature
# band (e.g., "chilled" in an ambient product), confidence is multiplied
# by the penalty lambda, typically pushing it below auto_threshold.
# CPG_RECONCILER_TEMP_BAND_PENALTY_ENABLED=false
# CPG_RECONCILER_TEMP_BAND_PENALTY_LAMBDA=0.3

# --- Optional, for environments behind a TLS-MITM proxy ---
# The ERP client auto-detects these standard env vars and combines their CA
# bundles with certifi's defaults. Leave unset in normal environments.
# REQUESTS_CA_BUNDLE=/path/to/your-corp-ca.pem
# NODE_EXTRA_CA_CERTS=/path/to/your-corp-ca.pem
# SSL_CERT_FILE=/path/to/explicit-bundle.pem  # explicit override
